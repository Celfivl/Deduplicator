{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Current Test",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}\\include",
                "-IC:\\msys64\\ucrt64\\include\\ncursesw", 
                "${workspaceFolder}\\src\\filesystem.c",
                "${workspaceFolder}\\src\\hashing.c",
                "${workspaceFolder}\\src\\datastruct.c", 
                "${workspaceFolder}\\src\\deduplicator.c",
                "${workspaceFolder}\\src\\tui_interface.c",
                "${file}", 
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lcrypto",
                "-lncursesw" 
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}